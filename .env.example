# Portfolio Environment Variables

# Email Service (Resend - Requires Full-Stack Hosting like Railway/Render)
# Get your API key at https://resend.com
RESEND_API_KEY=

# Static Hosting Alternative (GitHub Pages/Netlify/Vercel Static)
# Use Formspree if you cannot run the included Node.js server.ts
# Get your ID at https://formspree.io
VITE_FORMSPREE_ID=
